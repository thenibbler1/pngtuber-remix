[configuration]

entry_symbol = "custom_mesh_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.x86_64.debug = "windows/CustomMesh.windows.template_debug.x86_64.dll"
windows.x86_64.release = "windows/CustomMesh.windows.template_release.x86_64.dll"

linux.x86_64.debug = "linux/CustomMesh.linux.template_debug.x86_64.so"
linux.x86_64.release = "linux/CustomMesh.linux.template_release.x86_64.so"
