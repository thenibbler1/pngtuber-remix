[configuration]

entry_symbol = "global_input_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.x86_64.debug = "windows/GlobalInput.windows.template_debug.x86_64.dll"
windows.x86_64.release = "windows/GlobalInput.windows.template_release.x86_64.dll"

linux.x86_64.debug = "linux/GlobalInput.linux.template_debug.x86_64.so"
linux.x86_64.release = "linux/GlobalInput.linux.template_release.x86_64.so"
