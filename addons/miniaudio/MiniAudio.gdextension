[configuration]

entry_symbol = "mini_audio_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.x86_64.debug = "windows/MiniAudio.windows.template_debug.x86_64.dll"
windows.x86_64.release = "windows/MiniAudio.windows.template_release.x86_64.dll"

linux.x86_64.debug = "linux/MiniAudio.linux.template_debug.x86_64.so"
linux.x86_64.release = "linux/MiniAudio.linux.template_release.x86_64.so"
