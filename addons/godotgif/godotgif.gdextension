[configuration]

entry_symbol = "godot_gif_library_init"
compatibility_minimum = "4.7"

[libraries]

windows.x86_64.debug = "bin/godotgif.windows.template_debug.x86_64.dll"
windows.x86_64.release = "bin/godotgif.windows.template_release.x86_64.dll"

linux.x86_64.debug = "bin/libgodotgif.linux.template_debug.x86_64.so"
linux.x86_64.release = "bin/libgodotgif.linux.template_release.x86_64.so"
